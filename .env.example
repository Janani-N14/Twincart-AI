# TwinCart AI Environment Configuration
# Copy this file to .env and configure your variables

APP_ENV=development
LOG_LEVEL=INFO

# LLM Configuration (Groq Free Tier)
# Get a free key at https://console.groq.com/keys
# Offline fallback works automatically if no key is provided!
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# Backend URL for Frontend
TWINCART_API_URL=http://localhost:8000/api
